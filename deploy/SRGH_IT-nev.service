[Unit]
Description=SRGH IT Navigation Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sarangit
Group=sarangit
WorkingDirectory=/opt/SRGH_IT/nev
Environment=PORT=13013
EnvironmentFile=/etc/SRGH_IT/nev.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/SRGH_IT/nev/nev.jar
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
